{
	"name": "bobs-factory-monorepo",
	"version": "1.0.1",
	"private": true,
	"description": "Monorepo for Bob’s Factory - Linear Claude Agent integration",
	"homepage": "https://jappyjan.github.io/bobs-factory/",
	"packageManager": "pnpm@10.33.1",
	"type": "module",
	"scripts": {
		"factory": "pnpm --filter 'bobs-factory...' build && bun run scripts/factory.ts",
		"build": "pnpm -r --filter='!bobs-factory-electron' build",
		"dev": "pnpm -r --parallel dev",
		"test": "pnpm -r test",
		"lint": "biome check",
		"format": "biome check --write --unsafe",
		"test:packages": "pnpm --filter './packages/*' test",
		"test:packages:run": "pnpm --filter './packages/*' test:run",
		"test:apps": "pnpm --filter './apps/*' test",
		"typecheck": "pnpm -r typecheck",
		"prepare": "husky",
		"binary:build": "bun run scripts/build-binary.ts"
	},
	"keywords": [
		"linear",
		"claude",
		"linear-agent",
		"cyrus",
		"anthropic",
		"ai",
		"agent",
		"monorepo"
	],
	"author": "Ceedar",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jappyjan/bobs-factory.git"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2"
	},
	"dependencies": {
		"@linear/sdk": "60.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sqlite3"
		]
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json}": [
			"biome check --write --unsafe"
		]
	}
}
