{
	"name": "cyrus-edge-worker",
	"version": "0.2.73",
	"description": "Unified edge worker for processing Linear issues with Claude",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jappyjan/bobs-factory.git",
		"directory": "packages/edge-worker"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"prompt-template-v2.md",
		"prompt-template.md",
		"label-prompt-template.md",
		"prompts"
	],
	"scripts": {
		"build": "tsgo && tsgo -p tsconfig.web.json && npm run copy-prompts",
		"copy-prompts": "cp label-prompt-template.md dist/ && cp -r prompts dist/ && rm -rf dist/cyrus-skills-plugin && cp -rL cyrus-skills-plugin dist/cyrus-skills-plugin && node scripts/build-factory-web.mjs",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"typecheck": "tsgo --noEmit && tsgo -p tsconfig.web.json"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.281",
		"@linear/sdk": "^64.0.0",
		"@ngrok/ngrok": "^1.5.1",
		"chokidar": "^4.0.3",
		"cyrus-claude-runner": "workspace:*",
		"cyrus-cloudflare-tunnel-client": "workspace:*",
		"cyrus-codex-runner": "workspace:*",
		"cyrus-config-updater": "workspace:*",
		"cyrus-core": "workspace:*",
		"cyrus-cursor-runner": "workspace:*",
		"cyrus-gemini-runner": "workspace:*",
		"cyrus-github-event-transport": "workspace:*",
		"cyrus-gitlab-event-transport": "workspace:*",
		"cyrus-linear-event-transport": "workspace:*",
		"cyrus-mcp-tools": "workspace:*",
		"cyrus-opencode-runner": "workspace:*",
		"cyrus-simple-agent-runner": "workspace:*",
		"cyrus-slack-event-transport": "workspace:*",
		"cyrus-zulip-event-transport": "workspace:*",
		"fastify": "^5.12.5",
		"fastify-mcp": "^2.1.0",
		"file-type": "^21.3.2",
		"ignore": "^7.0.5",
		"node-forge": "^1.4.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@microsoft/fetch-event-source": "^2.0.1",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@tailwindcss/cli": "^4.3.3",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-virtual": "^3.14.13",
		"@types/node": "^20.0.0",
		"@types/node-forge": "^1.3.14",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/coverage-v8": "^4.1.11",
		"axios": "^1.20.0",
		"esbuild": "^0.28.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.18.4",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"vitest": "^4.1.11",
		"vitest-mock-extended": "^3.1.0",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
