{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noEmit": true,
		"allowJs": true,
		"checkJs": false
	},
	"include": ["src/factory/web/*.tsx", "src/factory/web/*.ts"],
	"exclude": ["node_modules", "dist"]
}
