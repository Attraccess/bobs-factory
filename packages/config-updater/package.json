{
	"name": "bobs-factory-config-updater",
	"version": "0.2.73",
	"description": "Configuration update handlers for Bob’s Factory agent",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jappyjan/bobs-factory.git",
		"directory": "packages/config-updater"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"scripts"
	],
	"scripts": {
		"build": "tsgo",
		"dev": "tsgo --watch",
		"typecheck": "tsgo --noEmit",
		"test": "vitest",
		"test:run": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.31.0",
		"bobs-factory-core": "workspace:*",
		"fastify": "^5.12.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^20.12.7",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11"
	},
	"keywords": [
		"config",
		"update",
		"handler",
		"cyrus"
	],
	"author": "Cyrus Team",
	"license": "Apache-2.0",
	"private": true
}
