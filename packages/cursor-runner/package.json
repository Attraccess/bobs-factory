{
	"name": "bobs-factory-cursor-runner",
	"version": "0.2.73",
	"description": "Cursor Agent CLI process wrapper for Bob’s Factory",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jappyjan/bobs-factory.git",
		"directory": "packages/cursor-runner"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsgo && node -e \"for(const f of ['permission-check.mjs','sdk-host.mjs']) require('node:fs').copyFileSync('src/'+f, 'dist/'+f)\"",
		"dev": "tsgo --watch",
		"test": "node ../../node_modules/.pnpm/node_modules/vitest/vitest.mjs",
		"test:run": "node ../../node_modules/.pnpm/node_modules/vitest/vitest.mjs run --passWithNoTests",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@connectrpc/connect-node": "^1.7.0",
		"@cursor/sdk": "^1.0.19",
		"bobs-factory-core": "workspace:*",
		"bobs-factory-simple-agent-runner": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11"
	},
	"private": true,
	"license": "Apache-2.0"
}
