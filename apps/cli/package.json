{
	"name": "bobs-factory",
	"version": "1.0.0-beta",
	"description": "AI-powered Linear issue automation using Claude",
	"main": "dist/src/app.js",
	"types": "dist/src/app.d.ts",
	"bin": {
		"bobs-factory": "./dist/src/app.js"
	},
	"type": "module",
	"scripts": {
		"build": "tsgo",
		"start": "node dist/src/app.js",
		"dev": "tsgo --watch",
		"test": "vitest run",
		"test:run": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit"
	},
	"files": [
		"dist",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jappyjan/bobs-factory.git",
		"directory": "apps/cli"
	},
	"keywords": [
		"linear",
		"claude",
		"ai",
		"automation",
		"cli"
	],
	"author": "",
	"license": "Apache-2.0",
	"dependencies": {
		"@linear/sdk": "^64.0.0",
		"@sentry/node": "^10.65.0",
		"bobs-factory-claude-runner": "workspace:*",
		"bobs-factory-cloudflare-tunnel-client": "workspace:*",
		"bobs-factory-config-updater": "workspace:*",
		"bobs-factory-core": "workspace:*",
		"bobs-factory-cursor-runner": "workspace:*",
		"bobs-factory-edge-worker": "workspace:*",
		"bobs-factory-mcp-tools": "workspace:*",
		"bobs-factory-slack-event-transport": "workspace:*",
		"commander": "^14.0.2",
		"dotenv": "^16.5.0",
		"express": "^5.2.1",
		"fastify": "^5.12.5",
		"file-type": "^21.0.0",
		"fs-extra": "^11.3.0",
		"node-fetch": "^2.7.0",
		"open": "^10.0.0",
		"zod": "^4.3.5",
		"reflect-metadata": "^0.2.2"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/ui": "^4.1.11",
		"vitest": "^4.1.11"
	},
	"private": true
}
