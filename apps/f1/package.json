{
	"name": "bobs-factory-f1",
	"version": "0.1.0",
	"type": "module",
	"description": "F1 Testing Framework CLI for Bob’s Factory",
	"main": "dist/src/cli.js",
	"types": "dist/src/cli.d.ts",
	"bin": {
		"f1": "./f1"
	},
	"scripts": {
		"build": "tsgo",
		"start": "bun run dist/src/cli.js",
		"server": "bun run server.ts",
		"server:dev": "bun --watch server.ts",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"prepublishOnly": "cd ../.. && pnpm build"
	},
	"files": [
		"dist",
		"f1",
		"server.ts",
		"README.md",
		"CLAUDE.md"
	],
	"dependencies": {
		"commander": "^14.0.2",
		"bobs-factory-claude-runner": "workspace:*",
		"bobs-factory-core": "workspace:*",
		"bobs-factory-edge-worker": "workspace:*",
		"bobs-factory-slack-event-transport": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"private": true,
	"license": "Apache-2.0"
}
